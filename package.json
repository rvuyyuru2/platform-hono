{
  "name": "platform-hono",
  "version": "2.0.0",
  "description": "High-performance NestJS HTTP adapter for Hono — 100% compatible with NestJS v11, Node.js & Bun",
  "author": "rvuyyuru2",
  "repository": {
    "type": "git",
    "url": "https://github.com/rvuyyuru2/platform-hono"
  },
  "license": "MIT",
  "keywords": [
    "nestjs",
    "nest",
    "hono",
    "adapter",
    "platform",
    "http",
    "web",
    "framework",
    "server",
    "rest",
    "api",
    "typescript",
    "graphql",
    "bun",
    "performance"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./adapters": {
      "types": "./dist/esm/src/adapters/index.d.ts",
      "require": "./dist/cjs/src/adapters/index.js",
      "import": "./dist/esm/src/adapters/index.js"
    },
    "./interfaces": {
      "types": "./dist/esm/src/interfaces/index.d.ts",
      "require": "./dist/cjs/src/interfaces/index.js",
      "import": "./dist/esm/src/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "hono": "^4.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/graphql": {
      "optional": true
    },
    "@nestjs/apollo": {
      "optional": true
    },
    "@apollo/server": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9"
  },
  "optionalDependencies": {
    "@apollo/server": "^5.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/apollo": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.1.17",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.11",
    "@types/autocannon": "^7.12.7",
    "@types/bun": "^1.3.8",
    "@types/ws": "^8.18.1",
    "autocannon": "^8.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.5.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "graphql": "^16.13.2",
    "graphql-subscriptions": "^3.0.0",
    "hono": "^4.12.9",
    "prettier": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "undici": "^7.21.0",
    "ws": "^8.20.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:esm": "bun ./node_modules/typescript/bin/tsc --p tsconfig.esm.json",
    "build:cjs": "bun ./node_modules/typescript/bin/tsc --p tsconfig.cjs.json",
    "build": "bun run clean && bun run build:esm && bun run build:cjs",
    "prepublishOnly": "bun run build",
    "dev": "cd example && nest start -w --copy-files --exec \"bun run --inspect\"",
    "example:rest": "bun run --bun examples/rest/src/main.ts",
    "example:graphql": "bun run --bun examples/graphql/src/main.ts",
    "benchmark": "bun run dev:bun & ( sleep 5 && autocannon -c 200 -d 5 -p 10 http://localhost:3000 )",
    "benchmark:file": "bun run dev:bun & ( sleep 5 && bun run ./benchmarks/benchmark.mjs)",
    "benchmark:suite": "bun run ./benchmarks/suite.mjs",
    "benchmark:servers": "bun run ./benchmarks/server.mjs",
    "benchmark:nest": "bun run --bun ./benchmarks/nest-server.mjs",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "trustedDependencies": [
    "@apollo/protobufjs",
    "@nestjs/core",
    "@swc/core",
    "bun"
  ]
}
